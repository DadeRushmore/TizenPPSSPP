+void VertexDecoderJitCache::Jit_TcU16PrescaleMorph() {
+	// Keep scalar VFP arithmetic and its operation order for this former
+	// interpreter path. NEON arithmetic would flush subnormal morph weights.
+	// Q0 contains the raw scale/offset; normalization happens after scaling.
+	ADDI2R(tempReg1, srcReg, dec_->tcoff, scratchReg);
+	MOVP2R(tempReg2, &gstate_c.morphWeights[0]);
+	MOVI2F(S8, 0.0f, scratchReg);
+	VMOV(S9, S8);
+	for (int n = 0; n < dec_->morphcount; ++n) {
+		LDRH(scratchReg, tempReg1, 0);
+		VMOV(S4, scratchReg);
+		VCVT(S4, S4, TO_FLOAT);
+		LDRH(scratchReg, tempReg1, 2);
+		VMOV(S5, scratchReg);
+		VCVT(S5, S5, TO_FLOAT);
+		VLDR(S6, tempReg2, 0);
+		VMUL(S7, S4, S6);
+		VADD(S8, S8, S7);
+		VMUL(S7, S5, S6);
+		VADD(S9, S9, S7);
+		ADDI2R(tempReg1, tempReg1, dec_->onesize_, scratchReg);
+		ADD(tempReg2, tempReg2, 4);
+	}
+	MOVI2F(S10, by32768, scratchReg);
+	VMUL(S8, S8, S0);
+	VMUL(S8, S8, S10);
+	VADD(S8, S8, S2);
+	VMUL(S9, S9, S1);
+	VMUL(S9, S9, S10);
+	VADD(S9, S9, S3);
+	ADDI2R(tempReg1, dstReg, dec_->decFmt.uvoff, scratchReg);
+	VSTR(S8, tempReg1, 0);
+	VSTR(S9, tempReg1, 4);
+}
