+         userMemory.GetTotalFreeBytes(), userMemory.GetLargestFreeBlockSize(), (unsigned)threads.size());
+      unsigned rows = 0;
+      for (const auto &thread : threads) {
+         if (rows++ == 32) break;
+         char name[KERNELOBJECT_MAX_NAME_LENGTH + 1];
+         memcpy(name, thread.name, sizeof(name));
+         name[sizeof(name) - 1] = 0;
+         for (char *c = name; *c; ++c) if ((unsigned char)*c <= 32) *c = '_';
+         INFO_LOG(Log::Boot, "GUEST_ERROR_THREAD id=%d name=%s pc=%08x status=%u wait_type=%u wait_id=%d priority=%d current=%u",
+            thread.id, name, thread.curPC, (unsigned)thread.status, (unsigned)thread.waitType,
+            thread.waitID, thread.priority, thread.isCurrent ? 1U : 0U);
+      }
+   }
