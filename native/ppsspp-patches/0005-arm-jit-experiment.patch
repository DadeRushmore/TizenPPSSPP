 void IRNativeJit::RunDowncount() {
 	PROFILE_THIS_SCOPE("jit");
+#ifdef TIZENPSP_ARM_JIT
+	TizenJitDispatch(true, mips_->pc);
+#endif
 	hooks_.enterDispatcher();
+#ifdef TIZENPSP_ARM_JIT
+	TizenJitDispatch(false, mips_->pc);
+#endif
 }
 
