+#ifdef TIZENPSP_ARM_JIT
+// Syscall/replacement code may embed resolved host function pointers beyond the IR.
+// Debug/tracing/interpreter paths deliberately keep ordinary invalidation.
+static bool TizenRetainableIR(const std::vector<IRInst> &instructions) {
+	if (instructions.empty()) return false;
+	for (const auto &inst : instructions) {
+		switch (inst.op) {
+		case IROp::Syscall: case IROp::SyscallUnresolved: case IROp::CallReplacement:
+		case IROp::Interpret: case IROp::Break: case IROp::Breakpoint:
+		case IROp::MemoryCheck: case IROp::LogIRBlock: case IROp::Bad:
+			return false;
+		default: break;
+		}
+	}
+	return true;
+}
+
+bool IRJit::TizenRetentionEnabled() const {
+	return !jo.optimizeForInterpreter && !mips_->IsMediaEngine() && !profiling_ &&
+		!mipsTracer.tracing_enabled && !g_breakpoints.HasBreakPoints() &&
+		!g_breakpoints.HasTempBreakPoint() && !g_breakpoints.HasMemChecks();
+}
+
+TizenIRRetention::Context IRJit::TizenRetentionContext() const {
+	return {(u32)g_Config.bFastMemory, (u32)Memory::DepthMirrorsActive(),
+		Memory::g_MemorySize, g_Config.uJitDisableFlags};
+}
+
+bool IRJit::TizenTryRetainBlock(int block_num, unsigned &revalidated) {
+	const JitBlock *block = blocks_.GetBlock(block_num);
+	u32 address, size; block->GetRange(&address, &size);
+	if (!block->IsValid() || Memory::MayRunInKernelMode(address) || !Memory::IsValidRange(address, size))
+		return false;
+	const u8 *bytes = blocks_.Space().GetPointerUnchecked(address);
+	if (!tizenRetention_.CodeMatches(block_num, address, TizenRetentionContext(), bytes, size))
+		return false;
+	// Re-resolve lookahead instructions, hooks, prefixes and compiler assumptions.
+	// A copy avoids changing the running frontend while examining cached blocks.
+	IRFrontend current = frontend_;
+	std::vector<IRInst> instructions;
+	u32 currentSize = 0;
+	current.DoJit(address, instructions, currentSize);
+	++revalidated;
+	if (currentSize != size || current.CheckRounding(address) || !TizenRetainableIR(instructions) ||
+		!tizenRetention_.IRMatches(block_num, instructions.data(), instructions.size() * sizeof(IRInst)))
+		return false;
+	// Keep native entry, block shadow, page index and link bookkeeping together.
+	tizenProbe_.Capture(block_num, bytes, size);
+	return true;
+}
+#endif
