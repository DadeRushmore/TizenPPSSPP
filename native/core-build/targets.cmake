# Remove native CPU code generators, retaining the IR interpreter/frontend.
target_sources(ppsspp_libretro PRIVATE
    "${TIZENPSP_ROOT}/native/core-build/runtime/emutls.c"
    "${TIZENPSP_ROOT}/native/core-build/runtime/thread-atexit.cpp")
get_target_property(core_sources Core SOURCES)
if(TIZENPSP_ARM_JIT)
    list(FILTER core_sources EXCLUDE REGEX "^MIPS/(ARM64|x86|RiscV|LoongArch64)/")
    target_sources(ppsspp_libretro PRIVATE "${TIZENPSP_ROOT}/native/core-build/runtime/jit-diagnostics.cpp")
else()
    list(FILTER core_sources EXCLUDE REGEX "^MIPS/(ARM|ARM64|x86|RiscV|LoongArch64)/")
endif()
set_property(TARGET Core PROPERTY SOURCES "${core_sources}")
get_target_property(gpu_sources GPU SOURCES)
if(TIZENPSP_ARM_JIT)
    list(FILTER gpu_sources EXCLUDE REGEX "^Common/VertexDecoder(Arm64|X86|RiscV|LoongArch64)\\.cpp$")
else()
    list(FILTER gpu_sources EXCLUDE REGEX "^Common/VertexDecoder(Arm|Arm64|X86|RiscV|LoongArch64)\\.cpp$")
endif()
set_property(TARGET GPU PROPERTY SOURCES "${gpu_sources}")
target_link_options(ppsspp_libretro PRIVATE "-Wl,--hash-style=sysv" "-Wl,-z,max-page-size=4096")
target_link_options(ppsspp_libretro PRIVATE "-nostartfiles")
target_link_options(ppsspp_libretro PRIVATE "-Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/libretro/link.T")
set_property(TARGET ppsspp_libretro APPEND PROPERTY LINK_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/libretro/link.T")
# EGL/GLES are host imports. Zig supplies compiler builtins; audit any remaining
# atomic imports rather than silently depending on a missing desktop libatomic.
foreach(core_target Common GPU Core ppsspp_libretro)
    foreach(link_property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(core_links ${core_target} ${link_property})
        if(core_links)
            list(FILTER core_links EXCLUDE REGEX "^(EGL|GLESv2|atomic)$")
            set_property(TARGET ${core_target} PROPERTY ${link_property} "${core_links}")
        endif()
    endforeach()
endforeach()
